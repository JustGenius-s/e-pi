{
  "name": "e-pi",
  "version": "0.1.0",
  "private": true,
  "description": "E-Pi is a focused desktop shell for Pi sessions, packages, and terminal workflows.",
  "license": "MIT",
  "author": "JustGenius",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/fix-dev-bundle-id.mjs && electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "build": "npm run typecheck && npm run test && electron-vite build",
    "fetch:node": "node scripts/fetch-node.mjs",
    "dist:mac": "npm run fetch:node && npm run build && electron-builder --mac",
    "fix:notif": "bash scripts/fix-notification-permission.sh",
    "dist:win": "npm run fetch:node && npm run build && electron-builder --win",
    "postinstall": "install-electron --no && electron-builder install-app-deps",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.8",
    "@earendil-works/pi-coding-agent": "0.84.0",
    "material-file-icons": "^2.4.0",
    "node-pty": "1.1.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@earendil-works/pi-tui": "0.84.0",
    "@pierre/diffs": "1.2.11",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "24.12.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.1.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "lucide-react": "1.28.0",
    "next-themes": "^0.4.6",
    "oxfmt": "0.62.0",
    "oxlint": "^1.77.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx}": "oxlint --fix",
    "*.{md,json}": "oxfmt"
  },
  "packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "node-pty"
    ],
    "patchedDependencies": {
      "@earendil-works/pi-coding-agent@0.84.0": "patches/@earendil-works__pi-coding-agent@0.84.0.patch",
      "@earendil-works/pi-tui@0.84.0": "patches/@earendil-works__pi-tui@0.84.0.patch"
    }
  },
  "build": {
    "appId": "works.earendil.e-pi",
    "productName": "E-Pi",
    "asar": true,
    "asarUnpack": [
      "node_modules/**"
    ],
    "files": [
      "out/**",
      "resources/**",
      "!resources/node/**",
      "package.json",
      "!node_modules/@mariozechner/clipboard-darwin-universal/**",
      "!node_modules/@mariozechner/clipboard-darwin-x64/**",
      "!node_modules/@mistralai/mistralai/src/**",
      "!node_modules/@anthropic-ai/sdk/src/**",
      "!node_modules/openai/src/**",
      "!node_modules/zod/src/**",
      "!node_modules/@earendil-works/pi-coding-agent/docs/**",
      "!node_modules/@earendil-works/pi-tui/native/win32/**",
      "!node_modules/@earendil-works/pi-tui/native/darwin/prebuilds/darwin-x64/**",
      "!node_modules/node-pty/prebuilds/win32-*/**",
      "!node_modules/node-pty/prebuilds/darwin-x64/**",
      "!node_modules/**/*.map"
    ],
    "extraResources": [
      {
        "from": "resources/e-pi-bridge.ts",
        "to": "e-pi-bridge.ts"
      },
      {
        "from": "resources/e-pi-light.json",
        "to": "e-pi-light.json"
      },
      {
        "from": "patches/@earendil-works__pi-coding-agent@0.84.0.patch",
        "to": "pi-compatibility/pi-coding-agent.patch"
      },
      {
        "from": "patches/@earendil-works__pi-tui@0.84.0.patch",
        "to": "pi-compatibility/pi-tui.patch"
      },
      {
        "from": "resources/node",
        "to": "node"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
