{
  "name": "e-pi",
  "version": "0.1.0",
  "private": true,
  "description": "E-Pi is a focused desktop shell for Pi sessions, packages, and terminal workflows.",
  "author": "JustGenius",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "build": "npm run typecheck && npm run test && electron-vite build",
    "dist:mac": "npm run build && electron-builder --mac",
    "postinstall": "install-electron --no && electron-builder install-app-deps",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@earendil-works/pi-tui": "0.83.0",
    "@pierre/diffs": "1.2.11",
    "@tailwindcss/vite": "^4.3.3",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "1.28.0",
    "node-pty": "1.1.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.1.1",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "0.62.0",
    "oxlint": "^1.77.0",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx}": "oxlint --fix"
  },
  "packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "node-pty"
    ]
  },
  "build": {
    "appId": "works.earendil.e-pi",
    "productName": "E-Pi",
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "files": [
      "out/**",
      "resources/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/e-pi-bridge.ts",
        "to": "e-pi-bridge.ts"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}
